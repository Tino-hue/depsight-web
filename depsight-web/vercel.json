{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/download/[...path].ts": { "maxDuration": 30, "memory": 512 },
    "api/health.ts": { "maxDuration": 5, "memory": 256 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|icons\\.svg|og\\.png|depsight\\.wasm|demo\\.mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
